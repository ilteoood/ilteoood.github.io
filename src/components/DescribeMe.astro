---
import TypeWriter from '../components/TypeWriter.astro'
---

<section
  id="describe-me"
  class="relative flex min-h-screen items-center px-6 pt-24 md:px-12 md:pt-32 xl:px-24"
>
  <div class="mx-auto w-full max-w-6xl">
    <p class="eyebrow mb-6 md:mb-8">
      <span class="text-accent">~/</span>portfolio<span class="text-muted"> · readme.md</span>
    </p>

    <div class="reveal">
      <h1
        class="font-mono text-[clamp(2.25rem,7vw,5.5rem)] leading-[1.05] font-bold tracking-tight"
      >
        <span class="text-muted">$</span>
        whoami<br>
        <span class="glow text-accent">Matteo Pietro Dazzi</span><span class="cursor-blink"></span>
      </h1>
    </div>

    <div class="reveal mt-6 md:mt-8">
      <p class="font-mono text-base text-muted md:text-lg">// role</p>
      <div class="mt-2 font-mono text-xl text-text md:text-2xl">
        <TypeWriter />
      </div>
    </div>

    <div class="reveal mt-10 grid gap-6 md:mt-14 md:grid-cols-3">
      <div class="divider pt-4">
        <p class="font-mono text-xs tracking-widest text-muted uppercase">Based in</p>
        <p class="mt-2 font-mono text-base text-text">Milan, IT</p>
      </div>
      <div class="divider pt-4">
        <p class="font-mono text-xs tracking-widest text-muted uppercase">Currently at</p>
        <p class="mt-2 font-mono text-base text-text">
          <a href="https://www.nearform.com/" rel="noopener noreferrer">Nearform</a>
        </p>
      </div>
      <div class="divider pt-4">
        <p class="font-mono text-xs tracking-widest text-muted uppercase">log(years) ≥</p>
        <p class="mt-2 font-mono text-base text-text">15</p>
      </div>
    </div>
  </div>
</section>
