---
import SectionTitle from '../components/SectionTitle.astro';

const content = ['Software engineer', 'Tech enthusiast', 'Music addicted'];
---

<section id="describe-me" class="min-h-screen flex items-center justify-center px-10 md:px-20 xl:px-40 pt-14">
  <div class="text-center">
    <h1 class="text-4xl sm:text-6xl xl:text-8xl font-bold mb-8 text-gray-100">
      {content[0]}
    </h1>
  </div>
</section>