---
import ProjectCard from "./ProjectCard.astro";

interface Repository {
  id: number;
  name: string;
  description: string | null;
  html_url: string;
  stargazers_count: number;
  forks_count: number;
  watchers_count: number;
  open_issues_count: number;
  updated_at: string;
  fork: boolean;
  archived: boolean;
}

const response = await fetch(
  "https://api.github.com/users/ilteoood/repos?per_page=100",
);
const allRepos: Repository[] = await response.json();

const repositories = allRepos
  .filter((repo: Repository) => !repo.fork)
  .sort(
    (a: Repository, b: Repository) =>
      new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime(),
  );

const initialCount = 12;
---

<div class="padding-content">
  <div class="pt-5 md:pt-10 xl:pt-14 pb-2 md:pb-5 xl:pb-7" id="projects">
    <h2 class="text-gray-50 text-2xl sm:text-4xl xl:text-6xl">Projects</h2>
  </div>

  <div id="projects-container" class="flex flex-wrap justify-between">
    {repositories.map((repo: Repository, index: number) => (
      <div class="mt-5 w-full md:w-[48%] lg:w-[30%] flex" data-extra={index >= initialCount ? "true" : "false"}>
        <ProjectCard project={repo} />
      </div>
    ))}
  </div>

  {repositories.length > initialCount && (
    <div id="show-more-container" class="flex justify-center mt-8">
      <button
        id="show-more-btn"
        class="px-6 py-3 bg-gray-700 hover:bg-gray-600 text-gray-50 rounded-lg transition-colors"
      >
        Show more
      </button>
    </div>
  )}
</div>

<style>
  [data-extra="true"] {
    display: none;
  }
</style>

<script>
  const showMoreBtn = document.getElementById("show-more-btn");
  const showMoreContainer = document.getElementById("show-more-container");

  showMoreBtn?.addEventListener("click", () => {
    document.querySelectorAll('[data-extra="true"]').forEach((el) => {
      (el as HTMLElement).style.display = "flex";
    });
    if (showMoreContainer) {
      showMoreContainer.style.display = "none";
    }
  });
</script>