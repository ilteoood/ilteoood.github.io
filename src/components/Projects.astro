---
interface Repository {
  name: string;
  description: string;
  html_url: string;
  forks_count: number;
  stargazers_count: number;
  watchers_count: number;
  open_issues_count: number;
}

const response = await fetch('https://api.github.com/users/ilteoood/repos?per_page=100');
const allRepos: Repository[] = await response.json();

const repositories = allRepos
  .filter(repo => !repo.fork && !repo.archived)
  .sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());

const repoToShow = 6;
---

<div class="padding-content">
  <div class="pt-5 md:pt-10 xl:pt-14 pb-2 md:pb-5 xl:pb-7" id="projects">
    <h2 class="text-gray-50 text-2xl sm:text-4xl xl:text-6xl">Projects</h2>
  </div>

  <div class="flex flex-wrap justify-between">
    {repositories.slice(0, repoToShow).map((repo) => (
      <div class="mt-5 w-full md:w-[48%] lg:w-[30%]">
        <a href={repo.html_url} class="block p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors text-color">
          <h3 class="text-xl font-semibold mb-2">{repo.name}</h3>
          <p class="text-lg italic mb-4">{repo.description || 'No description'}</p>
          <div class="flex gap-4 text-sm">
            <span>⭐ {repo.stargazers_count}</span>
            <span>🍴 {repo.forks_count}</span>
            <span>👁 {repo.watchers_count}</span>
            <span>❗ {repo.open_issues_count}</span>
          </div>
        </a>
      </div>
    ))}
  </div>
</div>