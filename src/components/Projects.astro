---
import ProjectCard from './ProjectCard.astro'
import { type Repository } from '../types/repository'

const response = await fetch('https://api.github.com/users/ilteoood/repos?per_page=100')
const allRepos: Repository[] = response.ok ? await response.json() : []

const repositories = allRepos
  .filter((repo: Repository) => !repo.fork)
  .sort(
    (a: Repository, b: Repository) =>
      new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime(),
  )

const initialCount = 12
---

<section class="padding-content">
  <div class="mx-auto max-w-6xl">
    <header id="projects" class="divider pt-10 md:pt-16">
      <div class="flex flex-col items-baseline gap-2 sm:flex-row sm:justify-between sm:gap-4">
        <h2 class="font-mono text-2xl font-semibold text-text sm:text-3xl md:text-4xl">
          <span class="text-accent">.</span>/projects
        </h2>
        <span class="font-mono text-xs text-muted md:text-sm">
          git log --author=ilteoood --count=<span class="text-accent">{repositories.length}</span>
        </span>
      </div>
    </header>

    <div id="projects-container" class="mt-10 grid gap-3 md:mt-14">
      {repositories.map((repo: Repository, index: number) => (
        <div class="reveal min-w-0" data-extra={index >= initialCount ? 'true' : 'false'}>
          <ProjectCard project={repo} />
        </div>
      ))}
    </div>

    {repositories.length > initialCount && (
      <div id="show-more-container" class="mt-12 flex justify-center">
        <button
          id="show-more-btn"
          type="button"
          class="font-mono text-sm text-text underline decoration-rule decoration-1 underline-offset-[6px] transition-colors hover:text-accent hover:decoration-accent md:text-base"
        >
          <span class="text-accent">→</span> load more commits
        </button>
      </div>
    )}
  </div>
</section>

<style>
[data-extra="true"] {
  display: none;
}
</style>

<script>
const showMoreBtn = document.getElementById('show-more-btn')
const showMoreContainer = document.getElementById('show-more-container')

showMoreBtn?.addEventListener('click', () => {
  document.querySelectorAll('[data-extra="true"]').forEach((el) => {
    ;(el as HTMLElement).style.display = 'grid'
  })
  if (showMoreContainer) {
    showMoreContainer.style.display = 'none'
  }
})
</script>
