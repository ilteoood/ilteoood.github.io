---
interface Repository {
  name: string;
  description: string;
  html_url: string;
  forks_count: number;
  stargazers_count: number;
  watchers_count: number;
  open_issues_count: number;
}
---

<div class="padding-content">
  <div class="pt-5 md:pt-10 xl:pt-14 pb-2 md:pb-5 xl:pb-7" id="projects">
    <h2 class="text-gray-50 text-2xl sm:text-4xl xl:text-6xl">Projects</h2>
  </div>

  <div id="projects-container" class="flex flex-wrap justify-between">
    <p class="text-gray-400">Loading projects...</p>
  </div>

  <div id="show-more-container" class="hidden justify-center mt-8">
    <button
      id="show-more-btn"
      class="px-6 py-3 bg-gray-700 hover:bg-gray-600 text-gray-50 rounded-lg transition-colors"
    >
      Show more
    </button>
  </div>
</div>

<script>
  interface Repository {
    name: string;
    description: string;
    html_url: string;
    forks_count: number;
    stargazers_count: number;
    watchers_count: number;
    open_issues_count: number;
  }

  const INITIAL_SHOW = 6;

  async function loadProjects() {
    const response = await fetch('https://api.github.com/users/ilteoood/repos?per_page=100');
    const allRepos: Repository[] = await response.json();

    const repositories = allRepos
      .filter((repo: Repository) => !repo.fork && !repo.archived)
      .sort((a: Repository, b: Repository) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());

    let displayedCount = INITIAL_SHOW;
    const container = document.getElementById('projects-container')!;
    const showMoreContainer = document.getElementById('show-more-container')!;
    const showMoreBtn = document.getElementById('show-more-btn')!;

    function renderProjects() {
      container.innerHTML = repositories.slice(0, displayedCount).map((repo) => `
        <div class="mt-5 w-full md:w-[48%] lg:w-[30%]">
          <a href="${repo.html_url}" class="block p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors text-color">
            <h3 class="text-xl font-semibold mb-2">${repo.name}</h3>
            <p class="text-lg italic mb-4">${repo.description || 'No description'}</p>
            <div class="flex gap-4 text-sm">
              <span>⭐ ${repo.stargazers_count}</span>
              <span>🍴 ${repo.forks_count}</span>
              <span>👁 ${repo.watchers_count}</span>
              <span>❗ ${repo.open_issues_count}</span>
            </div>
          </a>
        </div>
      `).join('');

      if (displayedCount < repositories.length) {
        showMoreContainer.classList.remove('hidden');
        showMoreContainer.classList.add('flex');
      } else {
        showMoreContainer.classList.add('hidden');
      }
    }

    showMoreBtn.addEventListener('click', () => {
      displayedCount = repositories.length;
      renderProjects();
    });

    renderProjects();
  }

  loadProjects();
</script>
