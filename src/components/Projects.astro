---
import { library, icon } from "@fortawesome/fontawesome-svg-core";
import {
  faStar,
  faCodeFork,
  faEye,
  faBug,
} from "@fortawesome/free-solid-svg-icons";

library.add(faStar, faCodeFork, faEye, faBug);

const icons = {
  star: icon(faStar, { classes: "text-yellow-500" }).html,
  fork: icon(faCodeFork, { classes: "text-blue-400" }).html,
  eye: icon(faEye, { classes: "text-green-400" }).html,
  bug: icon(faBug, { classes: "text-red-400" }).html,
};
---

<div class="padding-content">
  <div class="pt-5 md:pt-10 xl:pt-14 pb-2 md:pb-5 xl:pb-7" id="projects">
    <h2 class="text-gray-50 text-2xl sm:text-4xl xl:text-6xl">Projects</h2>
  </div>

  <div id="projects-container" class="flex flex-wrap justify-between">
    <p class="text-gray-400">Loading projects...</p>
  </div>

  <div id="show-more-container" class="hidden justify-center mt-8">
    <button
      id="show-more-btn"
      class="px-6 py-3 bg-gray-700 hover:bg-gray-600 text-gray-50 rounded-lg transition-colors"
    >
      Show more
    </button>
  </div>
</div>

<script define:vars={{ icons }}>
  const iconSvgs = icons;

  async function loadProjects() {
    const response = await fetch(
      "https://api.github.com/users/ilteoood/repos?per_page=100",
    );
    const allRepos = await response.json();

    const repositories = allRepos
      .filter((repo) => !repo.fork && !repo.archived)
      .sort(
        (a, b) =>
          new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime(),
      );

    let displayedCount = 6;
    const container = document.getElementById("projects-container");
    const showMoreContainer = document.getElementById("show-more-container");
    const showMoreBtn = document.getElementById("show-more-btn");

    function renderProjects() {
      container.innerHTML = repositories
        .slice(0, displayedCount)
        .map(
          (repo) => `
        <div class="mt-5 w-full md:w-[48%] lg:w-[30%] flex">
          <a href="${repo.html_url}" class="block p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors text-color flex flex-col flex-1">
            <h3 class="text-xl font-semibold mb-2">${repo.name}</h3>
            <p class="text-lg italic mb-4 min-h-[3rem] flex-1">${repo.description || "No description"}</p>
            <div class="flex flex-wrap gap-4 text-sm text-gray-400">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">${iconSvgs.star}</svg>
                ${repo.stargazers_count}
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">${iconSvgs.fork}</svg>
                ${repo.forks_count}
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">${iconSvgs.eye}</svg>
                ${repo.watchers_count}
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">${iconSvgs.bug}</svg>
                ${repo.open_issues_count}
              </span>
            </div>
          </a>
        </div>
      `,
        )
        .join("");

      if (displayedCount < repositories.length) {
        showMoreContainer.classList.remove("hidden");
        showMoreContainer.classList.add("flex");
      } else {
        showMoreContainer.classList.add("hidden");
      }
    }

    showMoreBtn.addEventListener("click", () => {
      displayedCount = repositories.length;
      renderProjects();
    });

    renderProjects();
  }

  loadProjects();
</script>
