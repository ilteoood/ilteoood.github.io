---
interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-center h-16">
      <div class="flex space-x-8">
        {sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="nav-link text-gray-50 hover:text-gray-200 transition-colors duration-200 text-sm font-medium"
            data-section={section.id}
          >
            {section.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: currentColor;
    transition: width 0.3s ease;
  }

  .nav-link.active::after {
    width: 100%;
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  let scrolled = false;

  const handleScroll = () => {
    if (window.scrollY > 150 && !scrolled) {
      navbar?.classList.add('bg-gray-900', 'shadow-lg');
      navbar?.classList.remove('bg-transparent');
      scrolled = true;
    } else if (window.scrollY <= 150 && scrolled) {
      navbar?.classList.remove('bg-gray-900', 'shadow-lg');
      navbar?.classList.add('bg-transparent');
      scrolled = false;
    }
  };

  const updateActiveLink = () => {
    const hash = window.location.hash.slice(1) || 'introduction';
    document.querySelectorAll('.nav-link').forEach(link => {
      const sectionId = link.getAttribute('data-section');
      if (sectionId === hash) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
  };

  window.addEventListener('scroll', handleScroll);
  window.addEventListener('hashchange', updateActiveLink);
  updateActiveLink();
</script>