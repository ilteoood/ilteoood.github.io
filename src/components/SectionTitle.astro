---
interface Props {
  title: string;
  sectionId: string;
  number?: string;
}

const { title, sectionId, number } = Astro.props;
---

<header id={sectionId} class="divider pt-10 md:pt-16">
  <div class="flex items-baseline gap-4">
    {number && (
      <span class="font-mono text-sm text-muted md:text-base">
        <span class="text-accent">//</span> {number}
      </span>
    )}
    <h2 class="font-mono text-2xl font-semibold text-text sm:text-3xl md:text-4xl">
      <span class="text-accent">.</span>/{title}
    </h2>
  </div>
</header>
