---
import { icon, library } from '@fortawesome/fontawesome-svg-core'
import {
  faMedium,
  faLinkedin,
  faGithub,
  faTelegram,
  faFacebook,
  faInstagram,
} from '@fortawesome/free-brands-svg-icons'
import { faSquareEnvelope } from '@fortawesome/free-solid-svg-icons'

library.add(faMedium, faLinkedin, faGithub, faTelegram, faFacebook, faInstagram, faSquareEnvelope)

const contacts = [
  { name: 'medium', icon: faMedium, link: 'https://ilteoood.medium.com/', label: 'Medium' },
  {
    name: 'linkedin',
    icon: faLinkedin,
    link: 'https://www.linkedin.com/in/ilteoood/',
    label: 'LinkedIn',
  },
  { name: 'github', icon: faGithub, link: 'https://github.com/ilteoood/', label: 'GitHub' },
  {
    name: 'email',
    icon: faSquareEnvelope,
    link: 'mailto:matteopietro.dazzi@gmail.com',
    label: 'Email',
  },
  {
    name: 'telegram',
    icon: faTelegram,
    link: 'https://telegram.me/iLTeoooD',
    label: 'Telegram',
  },
  {
    name: 'facebook',
    icon: faFacebook,
    link: 'https://facebook.com/iLTeoooD',
    label: 'Facebook',
  },
  {
    name: 'instagram',
    icon: faInstagram,
    link: 'https://www.instagram.com/_ilteoood',
    label: 'Instagram',
  },
]

const iconSvgs = contacts.map((contact) => ({
  html: icon(contact.icon).html,
  link: contact.link,
  label: contact.label,
  name: contact.name,
}))
---

<section class="padding-content">
  <div class="mx-auto max-w-3xl">
    <header id="contacts" class="divider pt-10 md:pt-16">
      <div class="flex items-baseline gap-4">
        <span class="font-mono text-sm text-muted md:text-base">
          <span class="text-accent">//</span>
          03
        </span>
        <h2 class="font-mono text-2xl font-semibold text-text sm:text-3xl md:text-4xl">
          <span class="text-accent">.</span>/contacts
        </h2>
      </div>
    </header>

    <div class="reveal mt-10 md:mt-14">
      <p class="font-mono text-sm text-muted md:text-base">
        <span class="text-accent">$</span>
        cat contacts.txt
      </p>
      <ul class="mt-4 divide-y divide-rule border-y border-rule">
        {iconSvgs.map((contact) => (
          <li>
            <a
              href={contact.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 px-2 py-3 transition-colors hover:bg-panel md:px-3 md:py-4"
              aria-label={contact.label}
            >
              <span class="font-mono text-muted text-xs md:text-sm">
                <span class="text-accent">→</span>
              </span>
              <span class="hidden h-4 w-4 text-text md:inline-flex [&_svg]:h-4 [&_svg]:w-4">
                <svg viewBox="0 0 512 512" class="fill-current" set:html={contact.html} />
              </span>
              <span class="font-mono text-sm text-text group-hover:text-accent md:text-base">
                {contact.name}
              </span>
              <span class="hidden font-mono text-muted text-xs md:inline md:flex-1 md:truncate">
                {contact.link.replace(/^https?:\/\//, '')}
              </span>
              <span class="ml-auto font-mono text-muted text-xs opacity-0 transition-opacity group-hover:opacity-100 md:text-sm">
                open ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
