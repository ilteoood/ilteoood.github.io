---

<div id="contacts" class="flex flex-wrap justify-center gap-4 py-8">
  {contacts.map((contact) => (
    <a
      class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-700 hover:bg-gray-600 transition-colors"
      href={contact.link}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current text-gray-300" set:html={iconSvgs[contact.icon]} />
    </a>
  ))}
</div>

