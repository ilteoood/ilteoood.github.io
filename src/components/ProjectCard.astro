---
import { library, icon } from "@fortawesome/fontawesome-svg-core";
import {
  faStar,
  faCodeFork,
  faEye,
  faBug,
} from "@fortawesome/free-solid-svg-icons";

library.add(faStar, faCodeFork, faEye, faBug);

const iconSvgs = {
  star: icon(faStar, { classes: "text-yellow-500" }).html,
  fork: icon(faCodeFork, { classes: "text-blue-400" }).html,
  eye: icon(faEye, { classes: "text-green-400" }).html,
  bug: icon(faBug, { classes: "text-red-400" }).html,
};

interface Props {
  name: string;
  description?: string;
  html_url: string;
  stargazers_count: number;
  forks_count: number;
  watchers_count: number;
  open_issues_count: number;
}

const { name, description = "No description", html_url, stargazers_count, forks_count, watchers_count, open_issues_count } = Astro.props;
---

<a href={html_url} class="block p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors text-color flex flex-col flex-1">
  <h3 class="text-xl font-semibold mb-2">{name}</h3>
  <p class="text-lg italic mb-4 min-h-[3rem] flex-1">{description}</p>
  <div class="flex flex-wrap gap-4 text-sm text-gray-400">
    <span class="flex items-center gap-1">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">{iconSvgs.star}</svg>
      {stargazers_count}
    </span>
    <span class="flex items-center gap-1">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">{iconSvgs.fork}</svg>
      {forks_count}
    </span>
    <span class="flex items-center gap-1">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">{iconSvgs.eye}</svg>
      {watchers_count}
    </span>
    <span class="flex items-center gap-1">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">{iconSvgs.bug}</svg>
      {open_issues_count}
    </span>
  </div>
</a>