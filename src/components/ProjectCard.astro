---
import { icon, library } from "@fortawesome/fontawesome-svg-core";
import {
    faBug,
    faCodeFork,
    faEye,
    faStar,
} from "@fortawesome/free-solid-svg-icons";
import ProjectStat from "./ProjectStat.astro";

library.add(faStar, faCodeFork, faEye, faBug);

const iconSvgs = {
  star: icon(faStar, { classes: "text-yellow-500" }).html,
  fork: icon(faCodeFork, { classes: "text-blue-400" }).html,
  eye: icon(faEye, { classes: "text-green-400" }).html,
  bug: icon(faBug, { classes: "text-red-400" }).html,
};

interface Props {
  project: {
    name: string;
    description: string | null;
    html_url: string;
    stargazers_count: number;
    forks_count: number;
    watchers_count: number;
    open_issues_count: number;
  };
}

const { project } = Astro.props;
const { name, description = "No description", html_url, stargazers_count, forks_count, watchers_count, open_issues_count } = project;
---

<a href={html_url} class="p-4 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors text-color flex flex-col flex-1">
  <h3 class="text-xl font-semibold mb-2">{name}</h3>
  <p class="text-lg italic mb-4 min-h-[3rem] flex-1">{description}</p>
  <div class="flex flex-wrap gap-4 text-sm text-gray-400">
    <ProjectStat value={stargazers_count} icon={iconSvgs.star} />
    <ProjectStat value={forks_count} icon={iconSvgs.fork} />
    <ProjectStat value={watchers_count} icon={iconSvgs.eye} />
    <ProjectStat value={open_issues_count} icon={iconSvgs.bug} />
  </div>
</a>