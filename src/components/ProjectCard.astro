---
import { icon, library } from '@fortawesome/fontawesome-svg-core';
import {
  faBug,
  faCodeFork,
  faEye,
  faStar,
} from '@fortawesome/free-solid-svg-icons';
import ProjectStat from './ProjectStat.astro';
import { type Repository } from '../types/repository';

library.add(faStar, faCodeFork, faEye, faBug);

const iconSvgs = {
  star: icon(faStar).html,
  fork: icon(faCodeFork).html,
  eye: icon(faEye).html,
  bug: icon(faBug).html,
};

interface Props {
  project: Repository;
}

const { project } = Astro.props;
const {
  name,
  description = 'No description',
  html_url,
  stargazers_count,
  forks_count,
  watchers_count,
  open_issues_count,
  updated_at,
} = project;

const descriptionDisplay = description ?? 'No description';
const finalDescription = descriptionDisplay || ' ';

const updatedDate = new Date(updated_at);
const updatedRel = formatRelative(updatedDate);
const commitHash = name.split('').reduce((a, c) => (a + c.charCodeAt(0)) % 0xffff, 0).toString(16).padStart(4, '0');

function formatRelative(date: Date): string {
  const diffMs = Date.now() - date.getTime();
  const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  if (days < 1) return 'today';
  if (days < 2) return 'yesterday';
  if (days < 30) return `${days}d ago`;
  if (days < 365) return `${Math.floor(days / 30)}mo ago`;
  return `${Math.floor(days / 365)}y ago`;
}
---

<a
  href={html_url}
  class="group block border-b border-rule px-3 py-4 transition-colors hover:bg-panel md:px-4 md:py-5"
  rel="noopener noreferrer"
>
  <div class="flex items-baseline gap-4 md:gap-6">
    <div class="w-24 shrink-0 font-mono text-xs text-muted md:w-32 md:text-sm">
      <span class="text-accent">●</span>
      <span class="ml-2">{commitHash}</span>
    </div>
    <div class="min-w-0 flex-1 text-left">
      <h3 class="truncate font-mono text-base text-text group-hover:text-accent md:text-lg">
        ./<span class="font-semibold">{name}</span>
      </h3>
      <p class="mt-1 line-clamp-2 min-h-5 font-body text-sm text-muted md:min-h-6 md:text-base">
        {finalDescription}
      </p>
    </div>
    <div class="hidden shrink-0 font-mono text-xs text-muted md:block md:text-right">
      <span class="text-accent">↑</span> {updatedRel}
    </div>
  </div>
  <div class="mt-2 flex flex-wrap gap-3 font-mono text-xs text-muted md:mt-0 md:justify-end md:text-sm">
    <ProjectStat value={stargazers_count} icon={iconSvgs.star} />
    <ProjectStat value={forks_count} icon={iconSvgs.fork} />
    <ProjectStat value={watchers_count} icon={iconSvgs.eye} />
    <ProjectStat value={open_issues_count} icon={iconSvgs.bug} />
  </div>
</a>
