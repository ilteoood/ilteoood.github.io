---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar';
import DescribeMe from '../components/sections/DescribeMe';
import Introduction from '../components/sections/Introduction';
import AboutMe from '../components/sections/AboutMe';
import Projects from '../components/sections/Projects';
import Contacts from '../components/sections/Contacts';
import MadeWith from '../components/sections/MadeWith';

const sections = [
  { id: 'about-me', label: 'About Me' },
  { id: 'projects', label: 'Projects' },
  { id: 'contacts', label: 'Contacts' },
];
---

<Layout title="Matteo Pietro Dazzi - Staff Software Developer">
  <NavBar client:load sections={sections} />
  <main>
    <DescribeMe client:load />
    <Introduction client:load />
    <AboutMe client:load />
    <Projects client:load />
    <Contacts client:load />
  </main>
  <MadeWith client:visible />
</Layout>